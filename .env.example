# Hermes + 9Router + Telegram
# Copy to .env, then replace CHANGE_ME values.
# Never commit the real .env file.

# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=CHANGE_ME_TELEGRAM_BOT_TOKEN

# Telegram USER ID(s) allowed to control Hermes.
# Comma-separated, e.g. 123456789,987654321
TELEGRAM_ALLOWED_USERS=CHANGE_ME_TELEGRAM_USER_ID

# Optional: where Hermes should deliver scheduled/cron Telegram messages.
# For a private DM this can usually be your numeric Telegram user/chat ID.
TELEGRAM_HOME_CHANNEL=

# Optional: comma-separated Telegram group/forum chat IDs.
# Example: -1001234567890,-1009876543210
TELEGRAM_GROUP_ALLOWED_CHATS=

# 9Router OpenAI-compatible endpoint.
ROUTER_BASE_URL=http://127.0.0.1:20128/v1

# 9Router client/API key.
ROUTER_API_KEY=CHANGE_ME_9ROUTER_API_KEY

# Model ID exactly as exposed by GET /v1/models on your 9Router instance.
ROUTER_MODEL=CHANGE_ME_MODEL_ID

# Name of the GNU screen session that runs 9Router.
# Leave blank if you do not want healthcheck.sh to verify the screen session.
ROUTER_SCREEN_SESSION=9router

# Default Hermes system service name for the default ~/.hermes profile.
# Change only if you intentionally use a custom HERMES_HOME/profile.
HERMES_SERVICE_NAME=hermes-gateway
